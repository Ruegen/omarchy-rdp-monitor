{
  "schemaVersion": 1,
  "id": "io.github.ruegen.rdp-monitor",
  "name": "Remote Desktop Protocol",
  "version": "1.6.0",
  "description": "Shows when someone is controlling this machine over Remote Desktop Protocol, and notifies on connect",
  "author": "ruegen",
  "homepage": "https://github.com/ruegen/omarchy-rdp-monitor",
  "license": "MIT",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Remote Desktop Protocol",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "port": 0,
      "remapSuper": true
    },
    "schema": [
      {
        "key": "port",
        "type": "integer",
        "label": "Listen port (0 = auto from hypr-rdp)",
        "min": 0,
        "max": 65535,
        "step": 1,
        "defaultValue": 0
      },
      {
        "key": "remapSuper",
        "type": "boolean",
        "label": "Remap remote Super/Command to Ctrl",
        "defaultValue": true
      }
    ]
  }
}
