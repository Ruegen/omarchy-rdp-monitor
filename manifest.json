{
  "schemaVersion": 1,
  "id": "io.github.ruegen.rdp-monitor",
  "name": "RDP Monitor",
  "version": "1.3.0",
  "description": "Shows the IP of a Mac or PC controlling this machine over RDP and notifies on connect",
  "author": "ruegen",
  "homepage": "https://github.com/ruegen/omarchy-rdp-monitor",
  "license": "MIT",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "RDP Monitor",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "port": 0
    },
    "schema": [
      {
        "key": "port",
        "type": "integer",
        "label": "RDP port (0 = auto from hypr-rdp)",
        "min": 0,
        "max": 65535,
        "step": 1,
        "defaultValue": 0
      }
    ]
  }
}
