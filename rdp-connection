#!/bin/bash
# Detect inbound RDP controllers (Mac/PC connected to hypr-rdp on :3389).
set -euo pipefail

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/rdp-monitor"
mkdir -p "$(dirname "$STATE_FILE")"

notify() {
  local title="$1"
  local body="$2"
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send --app-name "hypr-rdp" "$title" "$body" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a "hypr-rdp" "$title" "$body" >/dev/null 2>&1 || true
  fi
}

peer_ip() {
  local peer="$1"
  local ip
  if [[ "$peer" == \[*\]:* ]]; then
    ip="${peer#\[}"
    ip="${ip%%\]*}"
  else
    ip="${peer%:*}"
  fi
  if [[ "$ip" == ::ffff:* ]]; then
    ip="${ip#::ffff:}"
  fi
  case "$ip" in
    ""|127.*|::1) return 1 ;;
  esac
  printf '%s\n' "$ip"
}

local_is_rdp() {
  local addr="$1"
  [[ "$addr" == *:3389 || "$addr" == \[*\]:3389 ]]
}

parse_ips() {
  command -v ss >/dev/null 2>&1 || return 0
  # This ss build omits the State column when filtering; local/peer are last two fields.
  ss -Htn state established 2>/dev/null | awk '{print $(NF-1), $NF}' | while read -r local peer; do
    [[ -n "${local:-}" && -n "${peer:-}" ]] || continue
    local_is_rdp "$local" || continue
    peer_ip "$peer" || true
  done | sort -u
}

current_ips=()
while IFS= read -r ip; do
  [[ -n "$ip" ]] && current_ips+=("$ip")
done < <(parse_ips)

prev_ips=()
if [[ -f "$STATE_FILE" ]]; then
  while IFS= read -r ip; do
    [[ -n "$ip" ]] && prev_ips+=("$ip")
  done < "$STATE_FILE"
fi

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

if [[ ${#current_ips[@]} -eq 0 ]]; then
  if [[ ${#prev_ips[@]} -gt 0 ]]; then
    notify "Controlling connection ended" "${prev_ips[0]}"
  fi
  rm -f "$STATE_FILE"
  echo '{"text":"","tooltip":"No controlling connection","class":"disconnected"}'
  exit 0
fi

first_ip="${current_ips[0]}"
prev_joined="$(printf '%s\n' "${prev_ips[@]}" | sort -u | paste -sd, -)"
curr_joined="$(printf '%s\n' "${current_ips[@]}" | sort -u | paste -sd, -)"

if [[ "$prev_joined" != "$curr_joined" ]]; then
  notify "Controlling connection" "$first_ip"
fi

printf '%s\n' "${current_ips[@]}" > "$STATE_FILE"

tooltip="Controlling connection\\n$(json_escape "$first_ip")"
echo "{\"text\":\"$(json_escape "$first_ip")\",\"tooltip\":\"$tooltip\",\"class\":\"connected\"}"
