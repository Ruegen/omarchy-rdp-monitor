#!/bin/bash
# Detect inbound RDP controllers connected to hypr-rdp.
# Port: optional $1 / RDP_MONITOR_PORT, else the live hypr-rdp listener,
# else bind from ~/.config/hypr-rdp/config.toml, else 3389.
set -euo pipefail

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/rdp-monitor"
mkdir -p "$(dirname "$STATE_FILE")"

valid_port() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] && ((10#$1 >= 1 && 10#$1 <= 65535))
}

port_from_addr() {
  local addr="$1"
  local port="${addr##*:}"
  valid_port "$port" || return 1
  printf '%s\n' "$port"
}

read_listening_port() {
  command -v ss >/dev/null 2>&1 || return 1
  local line addr
  while IFS= read -r line; do
    [[ "$line" == *hypr-rdp* ]] || continue
    addr=$(awk '{print $(NF-1)}' <<<"$line")
    port_from_addr "$addr" && return 0
  done < <(ss -Htlpn 2>/dev/null || true)
  return 1
}

read_config_port() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/hypr-rdp/config.toml"
  [[ -f "$cfg" ]] || return 1
  local bind
  bind=$(awk -F= '
    $0 ~ /^[[:space:]]*bind[[:space:]]*=/ {
      gsub(/[[:space:]"]/, "", $2)
      print $2
      exit
    }
  ' "$cfg")
  [[ -n "$bind" ]] || return 1
  port_from_addr "$bind"
}

resolve_port() {
  if valid_port "${1:-}"; then
    printf '%s\n' "$1"
    return
  fi
  if valid_port "${RDP_MONITOR_PORT:-}"; then
    printf '%s\n' "$RDP_MONITOR_PORT"
    return
  fi
  local p
  if p=$(read_listening_port); then
    printf '%s\n' "$p"
    return
  fi
  if p=$(read_config_port); then
    printf '%s\n' "$p"
    return
  fi
  printf '%s\n' "3389"
}

RDP_PORT="$(resolve_port "${1:-}")"

notify() {
  local title="$1"
  local body="$2"
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send --app-name "hypr-rdp" "$title" "$body" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a "hypr-rdp" "$title" "$body" >/dev/null 2>&1 || true
  fi
}

peer_ip() {
  local peer="$1"
  local ip
  if [[ "$peer" == \[*\]:* ]]; then
    ip="${peer#\[}"
    ip="${ip%%\]*}"
  else
    ip="${peer%:*}"
  fi
  if [[ "$ip" == ::ffff:* ]]; then
    ip="${ip#::ffff:}"
  fi
  case "$ip" in
    ""|127.*|::1) return 1 ;;
  esac
  printf '%s\n' "$ip"
}

local_is_rdp() {
  local addr="$1"
  [[ "$addr" == *:"$RDP_PORT" || "$addr" == \[*\]:"$RDP_PORT" ]]
}

parse_ips() {
  command -v ss >/dev/null 2>&1 || return 0
  # This ss build omits the State column when filtering; local/peer are last two fields.
  ss -Htn state established 2>/dev/null | awk '{print $(NF-1), $NF}' | while read -r local peer; do
    [[ -n "${local:-}" && -n "${peer:-}" ]] || continue
    local_is_rdp "$local" || continue
    peer_ip "$peer" || true
  done | sort -u
}

current_ips=()
while IFS= read -r ip; do
  [[ -n "$ip" ]] && current_ips+=("$ip")
done < <(parse_ips)

prev_ips=()
if [[ -f "$STATE_FILE" ]]; then
  while IFS= read -r ip; do
    [[ -n "$ip" ]] && prev_ips+=("$ip")
  done < "$STATE_FILE"
fi

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

if [[ ${#current_ips[@]} -eq 0 ]]; then
  if [[ ${#prev_ips[@]} -gt 0 ]]; then
    notify "RDP session ended" "${prev_ips[0]}"
  fi
  rm -f "$STATE_FILE"
  echo "{\"text\":\"\",\"tooltip\":\"Omarchy RDP — no session\",\"class\":\"disconnected\",\"port\":$RDP_PORT}"
  exit 0
fi

first_ip="${current_ips[0]}"
prev_joined="$(printf '%s\n' "${prev_ips[@]}" | sort -u | paste -sd, -)"
curr_joined="$(printf '%s\n' "${current_ips[@]}" | sort -u | paste -sd, -)"

if [[ "$prev_joined" != "$curr_joined" ]]; then
  notify "RDP session started" "$first_ip"
fi

printf '%s\n' "${current_ips[@]}" > "$STATE_FILE"

tooltip="Omarchy RDP\\n$(json_escape "$first_ip")"
echo "{\"text\":\"$(json_escape "$first_ip")\",\"tooltip\":\"$tooltip\",\"class\":\"connected\",\"port\":$RDP_PORT}"
