#!/bin/bash

# Enhanced script to detect RDP sessions with self-installation capabilities
# This script will run every 1-2 seconds to detect RDP connections

# Check if we're running in a terminal (for testing purposes)
if [[ $TERM == "xterm" ]] || [[ $TERM == "screen" ]] || [[ $TERM == "linux" ]]; then
    IS_TERMINAL=true
else
    IS_TERMINAL=false
fi

# File to persist last seen IPs for notification handling
STATE_FILE="$HOME/.local/state/omarchy/rdp-session"

# Create the state directory if it doesn't exist
mkdir -p "$(dirname "$STATE_FILE")"

# Function to check if hypr-rdp is installed and running
check_prerequisites() {
    # Check if hypr-rdp is available
    if ! command -v hypr-rdp &> /dev/null; then
        return 1
    fi
    
    # Check if hypr-rdp service is running
    if ! systemctl --user is-active --quiet hypr-rdp.service 2>/dev/null; then
        return 2
    fi
    
    # Check if port 3389 is listening
    if ! ss -tuln | grep -q ':3389 '; then
        return 3
    fi
    
    return 0  # All checks passed
}

# Function to display install instructions
show_install_instructions() {
    local error_code=$1
    
    # If we're in a terminal environment, we can provide more detailed text
    if [[ "$IS_TERMINAL" == true ]]; then
        echo "RDP Session Widget: Prerequisites not met"
        echo "----------------------------------------"
        case $error_code in
            1)
                echo "❌ hypr-rdp is not installed"
                echo "   Install it with: sudo apt install hypr-rdp (or equivalent for your system)"
                ;;
            2)
                echo "❌ hypr-rdp service is not running"
                echo "   Start it with: systemctl --user start hypr-rdp.service"
                echo "   Enable it for auto-start: systemctl --user enable hypr-rdp.service"
                ;;
            3)
                echo "❌ Port 3389 is not bound to 0.0.0.0:3389"
                echo "   Check your hypr-rdp configuration"
                ;;
        esac
        echo ""
        echo "Once you've installed and configured hypr-rdp, please restart the plugin."
        return 1
    else
        # For GUI integration, show a notification instead
        notify-send -u critical "RDP Session Widget" "Prerequisites not met. Please install hypr-rdp and ensure it's running."
        return 1
    fi
}

# Function to parse IP addresses from ss output
parse_ips() {
    ss -Htn state established '( sport = :3389 )' 2>/dev/null | \
    awk 'NR>1 {print $4}' | \
    while read -r line; do
        # Extract IP address
        if [[ $line =~ ^.*:([0-9]+)$ ]]; then
            ip_part="${line%:*}"
        else
            ip_part="$line"
        fi
        
        # Skip loopback addresses
        if [[ "$ip_part" == "127.0.0.1" ]] || [[ "$ip_part" == "::1" ]]; then
            continue
        fi
        
        # Strip IPv4-mapped IPv6 addresses (like ::ffff:192.168.x.x)
        if [[ "$ip_part" == "::ffff:"* ]]; then
            echo "${ip_part#::ffff:}"
        else
            echo "$ip_part"
        fi
    done
}

# Check prerequisites at startup
if ! check_prerequisites; then
    # If prerequisites are not met, show instructions and exit
    error_code=$?
    show_install_instructions $error_code
    
    # Show an empty response to hide the widget properly
    exit 0
fi

# Get current IPs
current_ips=()
while IFS= read -r ip; do
    if [[ -n "$ip" ]]; then
        current_ips+=("$ip")
    fi
done < <(parse_ips)

# Get previous IPs
if [[ -f "$STATE_FILE" ]]; then
    prev_ips=($(cat "$STATE_FILE"))
else
    prev_ips=()
fi

# Handle the case when there are no current sessions
if [[ ${#current_ips[@]} -eq 0 ]]; then
    # If we had previous connections, send a disconnect notification
    if [[ ${#prev_ips[@]} -gt 0 ]]; then
        # Send notification for disconnect
        notify-send -a hypr-rdp "User disconnected" "${prev_ips[0]}"
    fi
    # Clear the state file
    rm -f "$STATE_FILE"
    # Print nothing (widget disappears)
    exit 0
fi

# If we have current sessions, process them
if [[ ${#current_ips[@]} -gt 0 ]]; then
    # Get the first IP for display 
    first_ip="${current_ips[0]}"
    
    # If there were no previous connections or IPs changed, send notification
    if [[ ${#prev_ips[@]} -eq 0 ]] || [[ "${prev_ips[*]}" != "${current_ips[*]}" ]]; then
        notify-send -a hypr-rdp "User connected" "$first_ip"
    fi
    
    # Save current IPs to state file for next check
    printf '%s\n' "${current_ips[@]}" > "$STATE_FILE"
    
    # Output JSON for Waybar-style widget
    # The icon will be shown when connected, and tooltip will show the IP
    # When clicked, the tooltip shows the full IP info
    echo "{\"text\":\"󰢹\",\"tooltip\":\"User connected\n$first_ip\",\"class\":\"connected\"}"
fi